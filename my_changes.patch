     button.onclick = () => addReportBlock(button.dataset.reportSlot, button.dataset.after || "");
   });
   document.querySelectorAll("[data-remove-note]").forEach((button) => {
     button.onclick = () => removeReportBlock(button.dataset.removeNote);
   });
