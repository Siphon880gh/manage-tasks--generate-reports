 :root{
   --gold:#c48400;
   --sage:#3f6b3a;
   --fill-none:var(--white);
   --fill-acid:#eef6b8;
   --fill-blue:#d7e2ff;
   --fill-coral:#ffdcd3;
   --fill-gold:#ffe08a;
   --fill-sage:#d7ead0
 }
 .facet-bar{border:2px solid var(--ink);background:var(--white);margin:-2px 0 18px;padding:12px 16px;display:grid;gap:12px}
 .facet-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
 .facet-label,.color-picker legend{font-family:"DM Mono",monospace;font-size:11px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;min-width:56px}
 .facet-chips{display:flex;flex-wrap:wrap;align-items:center;gap:8px;flex:1}
 .facet-empty{color:var(--muted);font-size:16px}
 .facet-chip,.color-swatch,.card-tag,.tag-option,.color-choice{border:2px solid var(--ink);background:var(--white);box-shadow:none}
 .facet-chip{padding:6px 10px;font-size:14px;font-weight:700}
 .facet-chip[aria-pressed="true"],.color-swatch[aria-pressed="true"]{background:var(--ink);color:#fffefa}
 .color-swatch,.color-choice{display:inline-flex;align-items:center;gap:8px;padding:4px 8px 4px 4px;font-size:14px;font-weight:700}
 .color-swatch-fill{width:20px;height:20px;border:2px solid var(--ink);background:var(--fill-none);flex:0 0 20px}
 .color-swatch-fill[data-color="acid"]{background:var(--fill-acid)}
 .color-swatch-fill[data-color="blue"]{background:var(--fill-blue)}
 .color-swatch-fill[data-color="coral"]{background:var(--fill-coral)}
